{
  "name": "wticifes-foto",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Aplicação standalone para personalizar fotografias do WTICIFES 2026.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "npm run db:migrate && npm run build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "verify-logo": "node scripts/verify-logo.mjs",
    "extract-brand-colors": "node scripts/extract-brand-colors.mjs",
    "recolor-phrase": "node scripts/recolor-phrase.mjs",
    "check": "npm run verify-logo && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.1.0",
    "@upstash/ratelimit": "2.0.8",
    "@upstash/redis": "1.38.1",
    "@vercel/blob": "2.6.1",
    "drizzle-orm": "0.45.2",
    "next": "16.2.12",
    "next-auth": "5.0.0-beta.32",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.4",
    "@playwright/test": "1.62.1",
    "@types/node": "24.10.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "postcss": "8.5.25",
    "sharp": "$sharp"
  }
}
