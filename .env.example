# Integrações de infraestrutura (use valores distintos em cada ambiente).
DATABASE_URL=postgresql://usuario:senha@host.neon.tech/banco?sslmode=require
UPSTASH_REDIS_REST_URL=https://seu-banco.upstash.io
UPSTASH_REDIS_REST_TOKEN=upstash_token_aqui
# A integração nativa da Vercel também é reconhecida automaticamente pelos nomes
# UPSTASH_REDIS_REST_KV_REST_API_URL e UPSTASH_REDIS_REST_KV_REST_API_TOKEN.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_aqui

# Segredos aleatórios com pelo menos 32 caracteres.
DOWNLOAD_SIGNING_SECRET=gere-um-segredo-aleatorio-exclusivo
RATE_LIMIT_SECRET=gere-outro-segredo-aleatorio-exclusivo
ADMIN_AUDIT_SECRET=gere-outro-segredo-para-pseudonimos-de-auditoria
CRON_SECRET=gere-outro-segredo-aleatorio-exclusivo

# URL pública HTTPS, sem barra final.
NEXT_PUBLIC_APP_URL=https://foto.wticifes.com.br

# Auth.js + GitHub OAuth. Callback: https://SEU-DOMINIO/api/auth/callback/github
AUTH_SECRET=gere-um-segredo-aleatorio-do-authjs
AUTH_GITHUB_ID=github-oauth-client-id
AUTH_GITHUB_SECRET=github-oauth-client-secret
ADMIN_EMAIL_ALLOWLIST=admin1@exemplo.br,admin2@exemplo.br

# Chave de emergência.
GENERATION_ENABLED=true

# Limites distribuídos.
GLOBAL_MAX_PER_MINUTE=20
GLOBAL_MAX_PER_HOUR=200
GLOBAL_MAX_PER_DAY=1000
HARD_DAILY_LIMIT=1000
MAX_CONCURRENT_PROCESSING=5
DUPLICATE_WINDOW_SECONDS=86400
INVALID_ATTEMPT_BLOCK_SECONDS=1800
INVALID_ATTEMPT_THRESHOLD=5
PARTICIPANT_MAX_PER_HOUR=2
PARTICIPANT_MAX_PER_DAY=3
PARTICIPANT_MAX_TOTAL=10

# Retenção e vitrine.
BLOB_TTL_HOURS=24
PRIVATE_RETENTION_HOURS=24
PENDING_REVIEW_RETENTION_HOURS=72
REJECTED_RETENTION_HOURS=1
APPROVED_RETENTION_DAYS=30
SHOWCASE_INTERVAL_SECONDS=10
SHOWCASE_FEED_LIMIT=20

# Revisão humana obrigatória. Nenhum outro valor é aceito sem integração explícita.
CONTENT_SAFETY_PROVIDER=manual
